rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/current {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function valid() {
        return request.resource.data.keys().hasAll(['schema', 'revision', 'payload', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['schema', 'revision', 'payload', 'updatedAt'])
          && request.resource.data.schema == 1
          && request.resource.data.revision is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 800000
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
